# ==============================================================================
# VorldX Attendance System - Production Environment Configuration (API Backend)
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=production

# MongoDB Atlas Production Connection String
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/vorldx_attendance_prod?retryWrites=true&w=majority&appName=VorldXProd

# Cryptographic & Authentication Secrets
# Secure random 256-bit secret string (generate using `openssl rand -base64 32`)
JWT_SECRET=replace-with-a-cryptographically-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Allowed Client Origins (Comma-separated list of production URLs)
# E.g.: https://vorldx-hr.vercel.app,https://vorldx-display.vercel.app
CORS_ORIGIN=https://vorldx-hr.vercel.app,https://vorldx-display.vercel.app

# QR Code Cryptographic Settings
QR_ROTATION_SECONDS=30
QR_GRACE_SECONDS=15
DEFAULT_TIMEZONE=Asia/Kolkata

# Default Administrative Passwords (used on initial seed if collection is empty)
ADMIN_DEFAULT_PASSWORD=Admin@VorldX2026!ProdSecret#
HR_DEFAULT_PASSWORD=Hr@VorldX2026!ProdSecret#
EMPLOYEE_DEFAULT_PASSWORD=Employee@2026!ProdSecret#

# Brute-Force Rate Limiting & Account Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ==============================================================================
# Production OTP Mode Decision
# ==============================================================================
# When DEMO_OTP_MODE=false or NODE_ENV=production, OTP codes are NEVER returned
# in API responses. The backend enforces real external SMS delivery (Twilio / AWS SNS).
# Set to false for live production; set to true ONLY during local sandbox demos.
DEMO_OTP_MODE=false
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

