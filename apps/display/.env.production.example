# ==============================================================================
# VorldX Office QR Display Kiosk - Production Environment Configuration (Next.js)
# ==============================================================================

# Public URL of the deployed Express + Socket.io backend API
NEXT_PUBLIC_API_URL=https://api.vorldx.yourdomain.com

# Public WebSocket URL of the deployed Socket.io server
NEXT_PUBLIC_WS_URL=https://api.vorldx.yourdomain.com

# Optional default display kiosk identifier (pre-fills on initial display setup)
NEXT_PUBLIC_DEFAULT_TERMINAL_ID=term_lko_01

