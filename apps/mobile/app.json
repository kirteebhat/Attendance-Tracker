{
  "expo": {
    "name": "vorldx-attendance",
    "slug": "vorldx-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vorldx",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07080E",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07080E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vorldx.attendance",
      "buildNumber": "1.0.0",
      "backgroundColor": "#07080E"
    },
    "android": {
      "package": "com.vorldx.attendance",
      "versionCode": 1,
      "backgroundColor": "#07080E",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07080E"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/vorldx-attendance"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VorldX to access your camera to scan attendance QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
