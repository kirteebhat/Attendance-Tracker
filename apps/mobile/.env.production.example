# ==============================================================================
# VorldX Employee Mobile App - Production Environment Configuration (Expo)
# ==============================================================================

# Public URL of the deployed Express + Socket.io backend API
# NOTE: For physical phone local network testing, replace with:
# EXPO_PUBLIC_API_URL=http://<YOUR_COMPUTER_LAN_IP>:4000
# For production cloud deployment builds (EAS build), use the HTTPS production URL:
EXPO_PUBLIC_API_URL=https://api.vorldx.yourdomain.com
EXPO_PUBLIC_WS_URL=https://api.vorldx.yourdomain.com

