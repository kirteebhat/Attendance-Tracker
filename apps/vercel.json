{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd .. && npm install && npm run build --workspace=@vorldx/web",
  "outputDirectory": "web/dist",
  "installCommand": "cd .. && npm install",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
